#expected
| 1 *
|   0x0000008e PTR(--primary-color) 0x00000000
#reset

#data
* { --color: red !important }
#errors
#expected
| 1 *
|   0x0000048e PTR(--color) 0x00000000
#reset

#data
* { --spacing: 10px }
#errors
#expected
| 1 *
|   0x0000008e PTR(--spacing) 0x00000000
#reset

#data
* { --multi: one two three }
#errors
#expected
| 1 *
|   0x0000008e PTR(--multi) 0x00000000
#reset

#data
* { --color: red; color: inherit }
#errors
#expected
| 1 *
|   0x0000008e PTR(--color) 0x00000000 0x00000818
#reset

#data
* { color: var(--primary) }
#errors
#expected
| 1 *
|   0x0000008f PTR(color) 0x00000000
#reset

#data
* { color: var(--primary, red) }
#errors
#expected
| 1 *
|   0x0000008f PTR(color) 0x00000000
#reset

#data
* { color: var(--primary) !important }
#errors
