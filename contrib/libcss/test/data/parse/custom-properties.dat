| 1 *
|   0x0000048f PTR(color) 0x00000000
#reset

#data
* { --color: red; color: var(--color) }
#errors
#expected
| 1 *
|   0x0000008e PTR(--color) 0x00000000 0x0000008f PTR(color) 0x00000001
#reset

#data
* { --empty:; width: var(--empty, 12px) }
#errors
#expected
| 1 *
|   0x0000008e PTR(--empty) 0x00000000 0x0000008f PTR(width) 0x00000001
#reset

