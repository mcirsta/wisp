* { --primary-color: #ff0000 }
#errors
#expected
| 1 *
|   0x0000008d PTR(--primary-color) 0x00000000
#reset

#data
* { --color: red !important }
#errors
#expected
| 1 *
|   0x0000048d PTR(--color) 0x00000000
#reset

#data
* { --spacing: 10px }
#errors
#expected
| 1 *
|   0x0000008d PTR(--spacing) 0x00000000
#reset

#data
* { --multi: one two three }
#errors
#expected
| 1 *
|   0x0000008d PTR(--multi) 0x00000000
#reset

#data
* { --color: red; color: inherit }
#errors
#expected
| 1 *
|   0x0000008d PTR(--color) 0x00000000 0x00000818
#reset

#data
* { color: var(--primary) }
#errors
#expected
| 1 *
|   0x0000008e PTR(color) 0x00000000
#reset

#data
* { color: var(--primary, red) }
#errors
#expected
| 1 *
|   0x0000008e PTR(color) 0x00000000
#reset

#data
* { color: var(--primary) !important }
#errors
#expected
| 1 *
|   0x0000048e PTR(color) 0x00000000
#reset

#data
* { --color: red; color: var(--color) }
#errors
#expected
| 1 *
|   0x0000008d PTR(--color) 0x00000000 0x0000008e PTR(color) 0x00000001
#reset

#data
* { --empty:; width: var(--empty, 12px) }
#errors
#expected
| 1 *
|   0x0000008d PTR(--empty) 0x00000000 0x0000008e PTR(width) 0x00000001
#reset

#data
* { --w: 10px !important junk }
